generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdministrationRoute {
  SUBCUTANEOUS
  SUBLINGUAL
}

enum UserType {
  PROFESSIONAL
  PATIENT
}

enum Role {
  ADMINISTRATOR
  RECEPTIONIST
  PHYSICIAN
  NURSE
}

enum Profession {
  PHYSICIAN
  NURSE
  NURSING_TECHNICIAN
  RECEPTIONIST
}

enum VerificationPurpose {
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum TherapyStatus {
  IN_PROGRESS
  SUSPENDED
  COMPLETED
}

enum DoseStatus {
  SCHEDULED
  ADMINISTERED_ON_SCHEDULE
  ADMINISTERED_OFF_SCHEDULE
  ENTERED_IN_ERROR
}

enum DoseObservationPhase {
  PRE_ADMINISTRATION
  POST_ADMINISTRATION
}

/// Conduta imediata registrada junto da administração. Alterar a prescrição ou
/// a próxima previsão continua sendo comando próprio; aqui fica só a decisão
/// tomada na sala de aplicação.
enum DoseImmediateConduct {
  MAINTAIN
  REQUEST_PHYSICIAN_REVIEW
  SUSPEND_TREATMENT
}

enum LifecycleEventType {
  SUSPENSION
  RESUMPTION
  COMPLETION
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  MISSED
}

enum NotificationKind {
  PHYSICIAN_REVIEW_REQUESTED
  TREATMENT_SUSPENDED
}

enum ContactRequestStatus {
  RECEIVED
  HANDLED
}

model Organization {
  id    String @id @default(ulid())
  name  String @unique
  taxId String @unique

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  professionals       Professional[]
  patients            Patient[]
  professionalInvites InternalUserInvite[]
  auditLogs           AuditLog[]
  treatmentProtocols TreatmentProtocol[]
  protocolDefaults OrganizationProtocolDefault[]
  appointments Appointment[]
  automationEnabled Boolean @default(false)
  timeZone String @default("America/Sao_Paulo")
}

model ProfessionalRole {
  id String @id @default(ulid())

  professionalId String
  professional   Professional @relation("RoleHolder", fields: [professionalId], references: [id])

  role Role

  grantedAt   DateTime     @default(now())
  grantedById String
  grantedBy   Professional @relation("RoleGrantedById", fields: [grantedById], references: [id])

  revokedAt   DateTime?
  revokedById String?
  revokedBy   Professional? @relation("RoleRevokedById", fields: [revokedById], references: [id])

  @@index([professionalId, role])
  @@index([grantedById])
  @@index([revokedById])
}

model Professional {
  id String @id @default(ulid())

  userId         String       @unique
  user           User         @relation("ProfessionalAccount", fields: [userId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  fullName      String
  phoneNumber   String
  profession    Profession
  councilNumber String?
  councilUf     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  professionalRoles        ProfessionalRole[]   @relation("RoleHolder")
  professionalRolesGranted ProfessionalRole[]   @relation("RoleGrantedById")
  professionalRolesRevoked ProfessionalRole[]   @relation("RoleRevokedById")
  patientsResponsible      Patient[]            @relation("ResponsiblePhysician")
  internalUserInvites      InternalUserInvite[]

  @@index([organizationId, profession])
}

model Patient {
  id String @id @default(ulid())

  userId         String?      @unique
  user           User?        @relation("PatientAccount", fields: [userId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  responsiblePhysicianId String
  responsiblePhysician   Professional @relation("ResponsiblePhysician", fields: [responsiblePhysicianId], references: [id])

  fullName    String
  birthDate   DateTime
  weightInKg  Float
  phoneNumber String

  /// Documento protegido, apenas dígitos. Nullable porque o legado foi criado
  /// sem CPF e porque existe pessoa sem CPF conhecido — a ausência é um fato,
  /// não um valor a inventar. Unicidade vale por organização quando informado.
  cpf String?

  isActive   Boolean @default(true)
  isArchived Boolean @default(false)

  createdAt   DateTime @default(now())
  createdById String
  createdBy   User     @relation("PatientCreatedBy", fields: [createdById], references: [id])

  updatedAt   DateTime @default(now()) @updatedAt
  updatedById String
  updatedBy   User     @relation("PatientUpdatedBy", fields: [updatedById], references: [id])

  archivedAt   DateTime?
  archivedById String?
  archivedBy   User?     @relation("PatientArchivedBy", fields: [archivedById], references: [id])

  immunotherapies Immunotherapy[]
  appointments    Appointment[]

  @@unique([organizationId, cpf])
  @@index([organizationId, isActive, isArchived])
  @@index([responsiblePhysicianId])
  @@index([fullName])
}

model User {
  id       String   @id @default(ulid())
  email    String   @unique
  password String
  type     UserType

  isActive   Boolean @default(true)
  isArchived Boolean @default(false)

  tokenVersion Int @default(0)

  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation("UserCreatedBy", fields: [createdById], references: [id])

  updatedAt   DateTime @default(now()) @updatedAt
  updatedById String?
  updatedBy   User?    @relation("UserUpdatedBy", fields: [updatedById], references: [id])

  professional     Professional? @relation("ProfessionalAccount")
  patient          Patient?      @relation("PatientAccount")
  patientsCreated  Patient[]     @relation("PatientCreatedBy")
  patientsUpdated  Patient[]     @relation("PatientUpdatedBy")
  patientsArchived Patient[]     @relation("PatientArchivedBy")

  immunotherapiesCreated  Immunotherapy[] @relation("ImmunotherapyCreatedBy")
  immunotherapiesUpdated  Immunotherapy[] @relation("ImmunotherapyUpdatedBy")
  immunotherapiesArchived Immunotherapy[] @relation("ImmunotherapyArchivedBy")

  doses          Dose[]               @relation("AdministeredBy")
  dosesCreated   Dose[]               @relation("DoseCreatedBy")
  dosesUpdated   Dose[]               @relation("DoseUpdatedBy")
  dosesArchived  Dose[]               @relation("DoseArchivedBy")
  invitesCreated InternalUserInvite[] @relation("InviteCreatedBy")

  lifecycleEventsCreated TherapyLifecycleEvent[]   @relation("LifecycleCreatedBy")
  addendaCreated         DoseObservationAddendum[] @relation("AddendumCreatedBy")
  appointmentsCreated    Appointment[]             @relation("AppointmentCreatedBy")
  appointmentsUpdated    Appointment[]             @relation("AppointmentUpdatedBy")
  notifications           Notification[]           @relation("NotificationRecipient")
  notificationPreferences NotificationPreference[] @relation("NotificationPreferenceOwner")
  supportRequests         SupportRequest[]         @relation("SupportRequestAuthor")

  auditLogs          AuditLog[]
  usersCreated       User[]              @relation("UserCreatedBy")
  usersUpdated       User[]              @relation("UserUpdatedBy")
  verificationTokens VerificationToken[] @relation("UserVerificationToken")

  authSessions      AuthSession[]      @relation("UserAuthSession")
  mfaCredentials    MfaCredential[]    @relation("UserMfaCredential")
  mfaRecoveryCodes  MfaRecoveryCode[]  @relation("UserMfaRecoveryCode")
  preAuthChallenges PreAuthChallenge[] @relation("UserPreAuthChallenge")

  @@index([type, isActive, isArchived])
}

model VerificationToken {
  id        String              @id @default(ulid())
  userId    String
  user      User                @relation("UserVerificationToken", fields: [userId], references: [id])
  purpose   VerificationPurpose
  tokenHash String?
  newEmail  String?

  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  @@index([userId, purpose])
}

model Immunotherapy {
  id String @id @default(ulid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  immunoType           String
  administrationRoute  AdministrationRoute
  extract              String
  inductionStartDate   DateTime
  maintenanceStartDate DateTime?
  targetConcentration  Int
  targetVolume         Float

  status     TherapyStatus @default(IN_PROGRESS)
  isArchived Boolean       @default(false)

  createdAt   DateTime @default(now())
  createdById String
  createdBy   User     @relation("ImmunotherapyCreatedBy", fields: [createdById], references: [id])

  updatedAt   DateTime @default(now()) @updatedAt
  updatedById String
  updatedBy   User     @relation("ImmunotherapyUpdatedBy", fields: [updatedById], references: [id])

  archivedAt   DateTime?
  archivedById String?
  archivedBy   User?     @relation("ImmunotherapyArchivedBy", fields: [archivedById], references: [id])

  doses Dose[]

  /// Todas as prescrições já fixadas (imutáveis); a vigente é apontada por
  /// currentPrescriptionId. Revisão clínica cria snapshot novo e move o
  /// ponteiro — nada é editado nem apagado.
  prescriptions ProtocolPrescription[] @relation("TherapyPrescriptions")
  currentPrescriptionId String? @unique
  currentPrescription ProtocolPrescription? @relation("CurrentPrescription", fields: [currentPrescriptionId], references: [id])

  lifecycleEvents TherapyLifecycleEvent[]
  revision Int @default(0)
  targetVolumeExact Decimal? @db.Decimal(65, 30)

  @@index([patientId, status, isArchived])
  @@index([administrationRoute])
}

/// Ciclo de vida clínico com motivo, autoria e efeito explícito: suspensão,
/// retomada e encerramento nunca se reduzem ao campo status.
model TherapyLifecycleEvent {
  id String @id @default(ulid())

  immunotherapyId String
  immunotherapy   Immunotherapy @relation(fields: [immunotherapyId], references: [id])

  type     LifecycleEventType
  category String?
  reason   String

  /// Suspensão: previsão de retorno para a equipe reavaliar.
  expectedReturnAt DateTime?

  /// Encerramento: recomendações finais estruturadas do wizard.
  recommendations Json?

  /// Previsões arquivadas pelo evento (encerramento); trilha explícita.
  archivedDoseIds String[] @default([])

  createdAt   DateTime @default(now())
  createdById String
  createdBy   User     @relation("LifecycleCreatedBy", fields: [createdById], references: [id])

  @@index([immunotherapyId, createdAt])
}

/// Observação pós-aplicação tardia: registro adicional imutável com autoria e
/// instante próprios; nunca reescreve as observações da administração.
model DoseObservationAddendum {
  id String @id @default(ulid())

  doseId String
  dose   Dose   @relation(fields: [doseId], references: [id])

  reportedSideEffects     String[] @default([])
  administeredMedications String[] @default([])
  notes                   String?
  observedAt              DateTime

  conduct              DoseImmediateConduct?
  conductJustification String?

  createdAt   DateTime @default(now())
  createdById String
  createdBy   User     @relation("AddendumCreatedBy", fields: [createdById], references: [id])

  @@index([doseId, observedAt])
}

/// Compromisso de agenda: entidade própria, relacionada e distinta da dose.
/// Cancelamento e falta pertencem ao compromisso; a dose clínica não ganha
/// status de agenda.
model Appointment {
  id String @id @default(ulid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])

  /// Vínculo opcional e único com a previsão clínica que o compromisso agenda.
  doseId String? @unique
  dose   Dose?   @relation(fields: [doseId], references: [id])

  title    String?
  startsAt DateTime
  endsAt   DateTime
  status   AppointmentStatus @default(SCHEDULED)

  notes        String?
  statusReason String?
  revision     Int     @default(0)

  createdAt   DateTime @default(now())
  createdById String
  createdBy   User     @relation("AppointmentCreatedBy", fields: [createdById], references: [id])

  updatedAt   DateTime @default(now()) @updatedAt
  updatedById String
  updatedBy   User     @relation("AppointmentUpdatedBy", fields: [updatedById], references: [id])

  @@index([organizationId, startsAt])
  @@index([patientId, startsAt])
}

model Dose {
  id String @id @default(ulid())

  immunotherapyId  String
  immunotherapy    Immunotherapy @relation(fields: [immunotherapyId], references: [id])
  /// Conta do profissional que executou a aplicação; o registrador fica no AuditLog.
  administeredById String?
  administeredBy   User?         @relation("AdministeredBy", fields: [administeredById], references: [id])

  concentration      Int
  volume             Float
  scheduledAt        DateTime
  administeredAt     DateTime?
  nextIntervalInDays Int
  betweenDosesReport String

  /// Hora final da aplicação. `administeredAt` é o início; a janela completa
  /// pertence ao registro clínico, não à agenda.
  administrationEndedAt DateTime?


  immediateConduct              DoseImmediateConduct?
  immediateConductJustification String?

  status     DoseStatus @default(SCHEDULED)
  isArchived Boolean    @default(false)

  createdAt   DateTime @default(now())
  createdById String
  createdBy   User     @relation("DoseCreatedBy", fields: [createdById], references: [id])

  updatedAt   DateTime @default(now()) @updatedAt
  updatedById String
  updatedBy   User     @relation("DoseUpdatedBy", fields: [updatedById], references: [id])

  archivedAt   DateTime?
  archivedById String?
  archivedBy   User?     @relation("DoseArchivedBy", fields: [archivedById], references: [id])

  prescriptionId String?
  prescription ProtocolPrescription? @relation(fields: [prescriptionId], references: [id])
  plannedStepId String?
  administeredStepId String?
  plannedValues Json?
  administeredValues Json?
  plannedVolumeExact Decimal? @db.Decimal(65, 30)
  administeredVolumeExact Decimal? @db.Decimal(65, 30)
  sourceDoseId String? @unique
  sourceDose Dose? @relation("DoseSuccessor", fields: [sourceDoseId], references: [id])
  successor Dose? @relation("DoseSuccessor")
  recommendation Json?
  revision Int @default(0)
  observations DoseObservation[]
  observationAddenda DoseObservationAddendum[]
  appointment Appointment?

  @@index([immunotherapyId, scheduledAt])
  @@index([concentration, volume])
  @@index([administeredById])
  @@index([scheduledAt])
}

model DoseObservation {
  id String @id @default(ulid())

  doseId String
  dose   Dose   @relation(fields: [doseId], references: [id])

  phase                   DoseObservationPhase
  reportedSideEffects     String[]             @default([])
  administeredMedications String[]             @default([])
  notes                   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([doseId, phase])
}

/// Evento de saída gravado no MESMO commit do fato de origem. O consumidor o
/// materializa depois (notificação interna hoje; canais externos quando houver
/// provedor), com tentativas e falha visível — nunca um envio dentro da
/// transação clínica.
model OutboxEvent {
  id String @id @default(ulid())

  organizationId String
  kind           NotificationKind
  payload        Json

  createdAt   DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?

  notifications Notification[]

  @@index([processedAt, createdAt])
  @@index([organizationId, createdAt])
}

/// Notificação interna: destinatário, leitura e paginação. Deriva de um
/// OutboxEvent — a unicidade por (evento, destinatário) torna o consumidor
/// idempotente por construção.
model Notification {
  id String @id @default(ulid())

  organizationId String
  userId         String
  user           User   @relation("NotificationRecipient", fields: [userId], references: [id])

  outboxEventId String
  outboxEvent   OutboxEvent @relation(fields: [outboxEventId], references: [id])

  kind       NotificationKind
  title      String
  body       String
  entityType String?
  entityId   String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([outboxEventId, userId])
  @@index([userId, readAt, createdAt])
  @@index([organizationId, createdAt])
}

/// Preferência por tipo e destinatário; ausência = habilitado.
model NotificationPreference {
  id String @id @default(ulid())

  userId String
  user   User   @relation("NotificationPreferenceOwner", fields: [userId], references: [id])

  kind    NotificationKind
  enabled Boolean @default(true)

  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, kind])
}

/// Solicitação pública de contato/trial: persistida com confirmação de
/// recebimento; nenhum envio externo é simulado.
model DemoRequest {
  id String @id @default(ulid())
  requestId String @unique @db.Uuid
  name String
  lastName String
  email String
  phone String
  role String
  solution String
  specialty String
  professionals Int
  sourceHash String
  createdAt DateTime @default(now())
  emailAttempts Int @default(0)
  emailNextAttemptAt DateTime? @default(now())
  emailLeaseUntil DateTime?
  emailAcceptedAt DateTime?
  emailErrorCode String?

  @@index([emailNextAttemptAt, emailLeaseUntil])
  @@index([sourceHash, createdAt])
  @@index([email, createdAt])
  @@index([createdAt])
}

model ContactRequest {
  id String @id @default(ulid())

  name         String
  email        String
  organization String?
  message      String
  status       ContactRequestStatus @default(RECEIVED)

  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

/// Solicitação de suporte autenticada: registro persistido, não um mailto.
model SupportRequest {
  id String @id @default(ulid())

  organizationId String
  userId         String
  user           User   @relation("SupportRequestAuthor", fields: [userId], references: [id])

  subject String
  message String
  status  ContactRequestStatus @default(RECEIVED)

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
}

model AuditLog {
  id String @id @default(ulid())

  userId         String
  user           User         @relation(fields: [userId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  entityType    String
  entityId      String
  action        String
  oldValues     Json?
  newValues     Json?
  changedFields String[]
  sessionId     String?
  timestamp     DateTime @default(now())

  @@index([entityType, entityId, timestamp])
  @@index([userId, timestamp])
  @@index([organizationId, timestamp])
  @@index([timestamp])
}

model InternalUserInvite {
  id    String @id @default(ulid())
  token String @unique

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id])

  email     String
  fullName  String
  role      Role
  expiresAt DateTime
  usedAt    DateTime?

  isActive Boolean @default(true)

  createdAt   DateTime @default(now())
  createdById String
  createdBy   User     @relation("InviteCreatedBy", fields: [createdById], references: [id])

  updatedAt DateTime @default(now()) @updatedAt

  @@unique([email, organizationId, isActive])
  @@index([organizationId, isActive])
  @@index([expiresAt])
  @@index([professionalId])
}


enum ProtocolVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

model TreatmentProtocol {
  id String @id @default(ulid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  name String
  route AdministrationRoute
  available Boolean @default(true)
  createdById String
  createdAt DateTime @default(now())
  versions ProtocolVersion[]
  @@unique([id, organizationId])
  @@index([organizationId, route])
}

model ProtocolVersion {
  id String @id @default(ulid())
  protocolId String
  organizationId String
  protocol TreatmentProtocol @relation(fields: [protocolId, organizationId], references: [id, organizationId])
  number Int
  status ProtocolVersionStatus @default(DRAFT)
  definition Json
  schemaVersion Int @default(1)
  engineVersion String @default("1")
  revision Int @default(0)
  createdById String
  publishedById String?
  createdAt DateTime @default(now())
  publishedAt DateTime?
  prescriptions ProtocolPrescription[]
  defaults OrganizationProtocolDefault[]
  @@unique([protocolId, number])
  @@unique([id, organizationId])
}

model OrganizationProtocolDefault {
  organizationId String
  route AdministrationRoute
  organization Organization @relation(fields: [organizationId], references: [id])
  versionId String
  version ProtocolVersion @relation(fields: [versionId, organizationId], references: [id, organizationId])
  @@id([organizationId, route])
}

model ProtocolPrescription {
  id String @id @default(ulid())
  immunotherapyId String
  immunotherapy Immunotherapy @relation("TherapyPrescriptions", fields: [immunotherapyId], references: [id])
  organizationId String
  versionId String
  version ProtocolVersion @relation(fields: [versionId, organizationId], references: [id, organizationId])
  resolved Json
  revision Int @default(1)
  /// Motivo da revisão clínica quando este snapshot substituiu outro.
  revisionReason String?
  createdById String
  createdAt DateTime @default(now())
  doses Dose[]
  currentOf Immunotherapy? @relation("CurrentPrescription")

  @@index([immunotherapyId, createdAt])
}

/// Idempotência do cadastro de prescrição: mesma chave e corpo devolvem o
/// resultado original; chave reutilizada com corpo diferente é conflito.
model RegistrationCommand {
  id String @id @default(ulid())
  organizationId String
  actorId String
  key String
  requestHash String
  result Json
  createdAt DateTime @default(now())
  @@unique([organizationId, actorId, key])
}

model ClinicalCommand {
  id String @id @default(ulid())
  organizationId String
  actorId String
  doseId String
  key String
  requestHash String
  result Json
  createdAt DateTime @default(now())
  @@unique([organizationId, actorId, doseId, key])
}

enum MfaFactorType {
  TOTP
}

enum PreAuthPurpose {
  MFA_CHALLENGE
  MFA_ENROLLMENT
  REAUTHENTICATION
}

enum AuthSessionRevokeReason {
  LOGOUT
  LOGOUT_ALL
  DEVICE_REVOKED
  PASSWORD_CHANGED
  ACCOUNT_DISABLED
  MFA_CHANGED
  IDLE_TIMEOUT
  ABSOLUTE_TIMEOUT
  SUPERSEDED
}

/// Sessão opaca do navegador. O cookie transporta apenas o segredo; o banco
/// guarda o hash. Identidade, expiração e revogação vivem aqui.
model AuthSession {
  id String @id @default(ulid())

  /// SHA-256 do segredo aleatório enviado no cookie. Nunca o segredo em claro.
  secretHash String @unique
  /// SHA-256 do token CSRF sincronizador vinculado a esta sessão.
  csrfTokenHash String

  userId String
  user   User   @relation("UserAuthSession", fields: [userId], references: [id])

  /// Versão de autorização observada na criação; divergência invalida a sessão.
  authVersion Int

  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  lastInteractiveAt DateTime  @default(now())
  mfaVerifiedAt     DateTime?
  reauthenticatedAt DateTime?

  revokedAt     DateTime?
  revokedReason AuthSessionRevokeReason?

  /// Metadados mínimos para a tela de dispositivos; sem geolocalização inferida.
  userAgent     String?
  ipAddressHash String?

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

/// Segundo fator registrado pelo usuário. O segredo TOTP precisa ser reversível
/// para verificação, então é guardado com criptografia autenticada e chave externa.
model MfaCredential {
  id String @id @default(ulid())

  userId String
  user   User   @relation("UserMfaCredential", fields: [userId], references: [id])

  type  MfaFactorType @default(TOTP)
  label String

  secretCiphertext String
  secretIv         String
  secretAuthTag    String
  keyVersion       Int    @default(1)

  confirmedAt     DateTime?
  lastUsedAt      DateTime?
  /// Último contador TOTP aceito; impede replay do mesmo código.
  lastUsedCounter BigInt?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  revokedAt DateTime?

  @@index([userId, revokedAt])
}

/// Código de recuperação exibido uma vez, guardado por hash e consumido atomicamente.
model MfaRecoveryCode {
  id String @id @default(ulid())

  userId String
  user   User   @relation("UserMfaRecoveryCode", fields: [userId], references: [id])

  codeHash String @unique

  createdAt  DateTime  @default(now())
  consumedAt DateTime?

  @@index([userId, consumedAt])
}

/// Estado curto entre senha verificada e sessão clínica criada, ou desafio de
/// reautenticação de ação sensível. Não concede acesso clínico.
model PreAuthChallenge {
  id String @id @default(ulid())

  secretHash String @unique

  userId String
  user   User   @relation("UserPreAuthChallenge", fields: [userId], references: [id])

  purpose PreAuthPurpose

  /// Preenchido apenas em reautenticação, para vincular o desafio à sessão.
  sessionId String?
  /// Credencial em confirmação durante o enrollment de MFA.
  credentialId String?

  attemptCount Int @default(0)

  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

/// Tentativas de autenticação para limitar por conta, IP e operação.
model AuthAttempt {
  id String @id @default(ulid())

  /// Hash do identificador (e-mail normalizado ou IP); não guardar o valor cru.
  identifierHash String
  scope          String
  operation      String
  succeeded      Boolean
  occurredAt     DateTime @default(now())

  @@index([identifierHash, operation, occurredAt])
  @@index([occurredAt])
}
