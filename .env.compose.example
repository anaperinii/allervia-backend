# Generate the private file with: node scripts/operations/init-local.cjs
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
AUTH_SESSION_CSRF_SECRET=REPLACE_WITH_RANDOM_HEX
MFA_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_BYTE_BASE64
SUPER_ADMIN_REGISTRATION_KEY=REPLACE_WITH_RANDOM_HEX
ALLERVIA_WEB_PATH=../allervia-web


# Retenção de dados (DEC-03): com `true`, o expurgo aprovado roda a cada ~1 h
# (AuthAttempt>1d, challenges>1d, tokens>7d, MFA pendente>1d, sessões
# encerradas>30d, filas processadas>30d). Sem a variável: dry-run (só loga).
ALLERVIA_RETENTION_ENABLED=true
