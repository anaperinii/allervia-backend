# Demo-only environment. Copy to .env.demo.local and review every value.
# The demo loader refuses production, remote hosts, and database names that
# do not end with "demo". It never falls back to .env.
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/allervia_demo

# Provisioning key for the demo database only (min 24 chars).
SUPER_ADMIN_REGISTRATION_KEY=demo-only-provisioning-key-0001

# Session CSRF secret for the demo database only (min 32 chars).
AUTH_SESSION_CSRF_SECRET=demo-only-session-csrf-secret-32b

# Optional: enables MFA enrollment during seeding. Generate a fresh value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# MFA_ENCRYPTION_KEY=

# Local HTTP defaults
AUTH_INSECURE_COOKIES=true
# 5173 = vite dev; 5175 = porta dedicada do harness Playwright.
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5175
APP_BASE_URL=http://localhost:5173

# Email stays on the log transport; the loader enforces it regardless.
EMAIL_TRANSPORT=log
